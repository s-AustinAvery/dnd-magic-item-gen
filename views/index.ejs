<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head", { title: title }) %>
</head>
<body>
<!-- Header / Nav -->
<%- include("partials/header") %>

<!-- Main content -->
<main class="main-content">

    <!-- Generator card -->
    <section class="card generator-card">
        <h2>Magic Item Forge</h2>

        <form id="generator-form">

            <!-- Top row (Prefix Custom, Item Type, Suffix Custom) -->
            <div class="generator-top-row">
                <label class="checkbox-label">
                    <input type="checkbox" id="prefixCustom" name="prefixCustom">
                    Prefix Custom
                </label>

                <div class="item-type-group">
                    <span class="item-type-label">Item Type</span>
                    <div class="item-type-checkboxes">
                        <label class="checkbox-label">
                            <input type="checkbox" id="weaponType" name="itemType" value="weapon">
                            Weapon
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" id="armorType" name="itemType" value="armor">
                            Armor
                        </label>
                    </div>
                </div>

                <label class="checkbox-label checkbox-label-right">
                    Suffix Custom
                    <input type="checkbox" id="suffixCustom" name="suffixCustom">
                </label>
            </div>

            <!-- Fields row (Prefix select, Item select, Suffix select) -->
            <div class="generator-fields-row">
                <div class="field-slot">
                    <select id="prefixSelect" name="prefixSelect" class="hidden">
                        <option value="random">Random</option>
                        <option value="none">None</option>
                        <!-- JS will populate valid prefixes -->
                    </select>
                </div>

                <div class="field-slot">
                    <select id="itemSelect" name="itemSelect">
                        <option value="random">Random</option>
                        <!-- JS will populate weapons/armor here -->
                    </select>
                </div>

                <div class="field-slot">
                    <select id="suffixSelect" name="suffixSelect" class="hidden">
                        <option value="random">Random</option>
                        <option value="none">None</option>
                        <!-- JS will populate valid suffixes -->
                    </select>
                </div>
            </div>

            <!-- Generate button -->
            <div class="generate-btn-wrap">
                <button type="submit" class="generate-btn">Create Item</button>
            </div>

        </form>
    </section>

    <!-- Result rard -->
    <section class="card result-card hidden" id="resultCard">
        <div class="item-name" id="itemName">
            <!-- Generated item name -->
        </div>

        <p class="rarity-label" id="rarityLabel">
            <!-- Common/Uncommon/Rare/Epic -->
        </p>

        <ul class="item-properties" id="itemProperties">
            <!-- Generated properties -->
        </ul>

        <% if (user) { %>
            <button id="saveItemBtn">Save Item</button>
        <% } else { %>
            <p class="login-hint">Log in to save items.</p>
        <% } %>

        <div class="item-shine" id="itemShine"></div>
    </section>
</main>

<!-- Footer -->
<%- include("partials/foot") %>
<script src="/js/itemdisplay.js"></script>
<script src="/js/generatorcore.js"></script>
<script src="/js/main.js"></script>
<script src="/js/headnav.js"></script>
</body>
</html>