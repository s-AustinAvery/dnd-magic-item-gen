<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partials/head", { title: title }) %>
</head>
<body>
  <main class="auth-wrapper">
    <div class="auth-card">

      <a href="/" class="auth-back-link">&larr; Back to generator</a>

      <div class="auth-header">
        <div class="auth-icon">-- Banner --</div>
        <h2>Create Account</h2>
        <!-- <p class="auth-subtitle">Join</p> -->
      </div>

      <% if (error) { %>
        <div class="auth-error">
          <span class="error-icon">!</span>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/register" class="auth-form">
        <div class="form-group">
          <label for="username">Username</label>
          <input id="username" name="username" placeholder="Choose a username" required />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="Enter your email" required />
          <small class="field-hint">Demo project; real email not required.</small>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" placeholder="Create a password" required />
        </div>

        <button type="submit" class="auth-btn">Create Account</button>
      </form>

      <div class="auth-footer">
        <p>Already have an account? <a href="/login">Sign in</a></p>
      </div>

    </div>
  </main>
</body>